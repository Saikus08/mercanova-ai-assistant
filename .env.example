   # --- Database (PostgreSQL + pgvector) ---
   POSTGRES_USER=mercanova
   POSTGRES_PASSWORD=change-me
   POSTGRES_DB=mercanova
   # Host port of the database container. Change it when 5432 is taken.
   POSTGRES_PORT=5432

   # --- Ports ---
   BACKEND_PORT=8000
   OLLAMA_PORT=11434

   # --- Ollama ---
   # The compose service "ollama" runs on CPU and is very slow. For a native Ollama on the host
   # (recommended on macOS, uses the GPU) use http://host.docker.internal:11434
   OLLAMA_BASE_URL=http://ollama:11434

   # --- Chat model (decision 0001; the model comparison may change the default) ---
   LLM_MODEL=qwen3:8b
   # Seconds for one chat request.
   LLM_TIMEOUT_SECONDS=120
   LLM_TEMPERATURE=0.1
   LLM_NUM_CTX=8192
   # Reasoning mode of the model: leave unset for the model default, or set true / false.
   # LLM_THINK=false

   # --- Agent loop ---
   # Maximum model calls per chat turn before a degraded answer.
   AGENT_MAX_STEPS=6
   # Time budget of one chat turn, checked before each model call. A call already running
   # is not interrupted: it ends by its own LLM_TIMEOUT_SECONDS.
   AGENT_TURN_TIMEOUT_SECONDS=90
   # Recent messages sent to the model besides the system prompt and the state.
   AGENT_HISTORY_MESSAGES=8

   # --- Embeddings and search ---
   EMBEDDING_MODEL=nomic-embed-text
   EMBEDDING_TIMEOUT_SECONDS=120
   EMBEDDING_BATCH_SIZE=16
   # Minimum cosine similarity for a search hit to be shown (provisional value).
   SEARCH_MIN_SIMILARITY=0.62

   # --- Speech-to-text (faster-whisper, runs inside the backend container) ---
   # Model size: tiny, base, small, medium. It is downloaded on the first transcription.
   STT_MODEL=small
   STT_LANGUAGE=es

   # --- Dataset ---
   # Course Excel, mounted read-only from ./data. Not versioned.
   DATASET_PATH=/data/MercaNova_dataset_obligatorio_2.xlsx
